-- ============================================================
--  monitors.lua — per-machine display layout.
--  Loaded from custom.lua via pcall, so it's fine for this file
--  to be absent or to describe outputs that aren't connected.
--  List outputs with: hyprctl monitors
-- ============================================================

-- Two identical Dell U2518D 2560x1440 panels, told apart only by serial:
--   DP-5 = ...A7BL   DP-6 = ...A7WL
-- Pinned explicitly because "auto" ordered them the wrong way round.
hl.monitor({ output = "DP-6", mode = "preferred", position = "0x0",    scale = 1 })
hl.monitor({ output = "DP-5", mode = "preferred", position = "2560x0", scale = 1 })
