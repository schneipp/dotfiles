# Shell config, originally from Omarchy's default bash rc.
# Sourced by ~/.bashrc. Override anything here in ~/.bashrc itself.
_bash_conf=~/.config/bash

source "$_bash_conf/envs"
source "$_bash_conf/shell"
source "$_bash_conf/aliases"
source "$_bash_conf/functions"
source "$_bash_conf/init"
[[ $- == *i* ]] && bind -f "$_bash_conf/inputrc"
unset _bash_conf
