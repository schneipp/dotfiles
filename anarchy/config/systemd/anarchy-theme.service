[Unit]
Description=Push the DankMaterialShell palette into apps it does not theme
After=graphical-session.target

[Service]
Type=oneshot
# DMS rewrites dms-colors.json more than once per theme change and the path
# unit only fires on the first write, while the service is still idle. Wait for
# it to settle, or the mode read here is the old one and foot stays dark.
ExecStartPre=/usr/bin/sleep 1.5
ExecStart=%h/.local/bin/anarchy-theme-apply --quiet
