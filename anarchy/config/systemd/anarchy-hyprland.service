[Unit]
Description=Hyprland without a seat, served over RDP (anarchy)
# Lingering starts this at boot, with nobody logged in.

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/anarchy/headless.env
ExecStart=%h/.local/bin/anarchy-hyprland-headless
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
