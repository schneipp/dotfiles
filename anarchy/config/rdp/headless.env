# Environment for the headless Hyprland service (anarchy-hyprland.service).
# Apply changes with: systemctl --user restart anarchy-hyprland

# Use Alt instead of Super for every anarchy binding in this session. Useful
# when the client is itself a Hyprland that keeps Super for its own bindings —
# though the passthrough toggle (Super+Escape on the client, see custom.lua)
# handles that without giving up Super here.
#ANARCHY_MAINMOD=ALT

# Pin the GPU to open. By default the first card Mesa drives is used, with an
# NVIDIA one as the last resort.
#ANARCHY_DRM_DEVICE=/dev/dri/card1
