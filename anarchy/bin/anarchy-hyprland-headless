#!/usr/bin/env bash
#
# anarchy-hyprland-headless — Hyprland without a seat, for RDP.
#
# A normal Hyprland gets the GPU from logind, which hands it to whichever
# session is in front on the machine's one seat; a second user's Hyprland is
# then paused. With libseat's noop backend Hyprland opens the GPU device itself
# instead, so every user can run one at the same time. It needs read/write on
# the card (the video group) and no monitor: the screens it draws are virtual
# outputs that hypr-rdp creates.
#
# Started by the anarchy-hyprland user service. ANARCHY_DRM_DEVICE in
# ~/.config/anarchy/headless.env pins a card; otherwise the first one Mesa
# drives is used (the NVIDIA driver is the last resort).
set -uo pipefail

pick_card() {
  local c driver best="" fallback=""
  for c in /sys/class/drm/card[0-9]*; do
    [[ $c =~ card[0-9]+$ ]] || continue
    driver=$(basename "$(readlink -f "$c/device/driver")" 2>/dev/null)
    case $driver in
      nvidia) [[ -z $fallback ]] && fallback=/dev/dri/${c##*/} ;;
      *)      best=/dev/dri/${c##*/}; break ;;
    esac
  done
  echo "${best:-$fallback}"
}

card=${ANARCHY_DRM_DEVICE:-$(pick_card)}
[[ -n $card ]] || { echo "anarchy-hyprland-headless: no GPU device in /dev/dri" >&2; exit 1; }
[[ -r $card && -w $card ]] || {
  echo "anarchy-hyprland-headless: no access to $card — is $USER in the video group? (log in again after adding)" >&2
  exit 1
}

export LIBSEAT_BACKEND=noop
export AQ_DRM_DEVICES=$card
export XDG_SESSION_TYPE=wayland
echo "anarchy-hyprland-headless: $card"

if command -v start-hyprland >/dev/null; then
  exec start-hyprland
else
  exec Hyprland
fi
