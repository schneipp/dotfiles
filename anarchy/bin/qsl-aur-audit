#!/usr/bin/env python3
"""qsl-aur-audit — how much should you trust this AUR package?

The AUR is user-submitted and unreviewed. Real-world AUR malware has mostly
been one of three shapes: a brand-new package nobody has vouched for, an
orphaned package quietly adopted by someone new, or a build script that
fetches and runs something it does not show you. None of that is visible from
a package name, so this pulls the evidence together:

  - the AUR's own record: votes, popularity, age, last change, maintainer,
    original submitter, out-of-date flag
  - the PKGBUILD and any .install script, scanned for the patterns malicious
    packages have used: piping downloads into a shell, decoding blobs, raw-IP
    or paste-site URLs, setuid bits, persistence hooks
  - the name, compared with the official repos for one-letter look-alikes

Output is tab-separated for the launcher:

    risk    <low|medium|high>
    fact    <label>  <value>
    flag    <high|warn|info>  <message>
    source  <domain>
    line    <n>  <suspicious PKGBUILD line>

Pass --text for a human-readable report (used before an AUR install).

    qsl-aur-audit [--text] <package>
"""
import json
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request

AUR = "https://aur.archlinux.org"
TIMEOUT = 8

args = [a for a in sys.argv[1:] if not a.startswith("--")]
TEXT = "--text" in sys.argv
if not args:
    sys.exit("usage: qsl-aur-audit [--text] <package>")
pkg = args[0]

out = []          # (kind, *fields)
flags = []        # (severity, message)


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "anarchy-qsl-aur-audit"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        return r.read().decode("utf-8", "replace")


def ago(ts):
    days = (time.time() - ts) / 86400
    if days < 1:
        return "today"
    if days < 60:
        return f"{int(days)} days ago"
    if days < 730:
        return f"{int(days / 30)} months ago"
    return f"{days / 365:.1f} years ago"


def flag(sev, msg):
    flags.append((sev, msg))


# ------------------------------------------------------------------ record
try:
    info = json.loads(fetch(f"{AUR}/rpc/v5/info?arg[]={urllib.parse.quote(pkg)}"))
    results = info.get("results") or []
except Exception as e:
    print(f"risk\tunknown\nflag\twarn\tCould not reach the AUR: {e}")
    sys.exit(0)

if not results:
    print("risk\tunknown\nflag\tinfo\tNot an AUR package.")
    sys.exit(0)

r = results[0]
now = time.time()
votes = r.get("NumVotes") or 0
pop = r.get("Popularity") or 0
first = r.get("FirstSubmitted") or now
last = r.get("LastModified") or now
maint = r.get("Maintainer")
submitter = r.get("Submitter")
comaint = r.get("CoMaintainers") or []
# Split packages share one PKGBUILD, stored under the base name.
base = r.get("PackageBase") or pkg
age_days = (now - first) / 86400
changed_days = (now - last) / 86400

out.append(("fact", "Votes", f"{votes}"))
out.append(("fact", "Popularity", f"{pop:.2f}"))
out.append(("fact", "Maintainer", maint or "none — orphaned"))
if submitter and submitter != maint:
    out.append(("fact", "Submitted by", submitter))
if comaint:
    out.append(("fact", "Co-maintainers", ", ".join(comaint)))
out.append(("fact", "First submitted", ago(first)))
out.append(("fact", "Last changed", ago(last)))
if r.get("OutOfDate"):
    out.append(("fact", "Flagged out of date", ago(r["OutOfDate"])))

# Age and endorsement. A package a week old with no votes has had no eyes on it.
if age_days < 14 and votes < 5:
    flag("high", f"Brand new ({ago(first)}) and almost nobody has voted for it.")
elif age_days < 60 and votes < 5:
    flag("warn", f"Only {ago(first).replace(' ago', '')} old with {votes} vote(s).")
elif votes == 0:
    flag("warn", "No votes at all — nobody has vouched for it.")

# Change of hands. Orphans can be adopted by anyone, and a takeover followed by
# a fresh upload is exactly how several real AUR compromises happened.
if not maint:
    flag("warn", "Orphaned: anyone can adopt it and push an update.")
elif submitter and submitter != maint:
    if changed_days < 30:
        flag("high", f"Maintainer changed hands (was {submitter}, now {maint}) "
                     f"and it was updated {ago(last)}.")
    else:
        flag("info", f"Maintainer changed hands: submitted by {submitter}, now {maint}.")

# ------------------------------------------------------------------ name
try:
    official = subprocess.run(["pacman", "-Slq"], capture_output=True, text=True,
                              timeout=10).stdout.split()
except Exception:
    official = []


def one_edit(a, b):
    if a == b or abs(len(a) - len(b)) > 1:
        return False
    if len(a) == len(b):
        diff = [i for i in range(len(a)) if a[i] != b[i]]
        return len(diff) == 1 or (len(diff) == 2 and a[diff[0]] == b[diff[1]]
                                  and a[diff[1]] == b[diff[0]])
    short, long_ = (a, b) if len(a) < len(b) else (b, a)
    return any(long_[:i] + long_[i + 1:] == short for i in range(len(long_)))


if len(pkg) >= 4 and pkg not in official:
    lookalikes = sorted({o for o in set(official) if one_edit(pkg, o)})
    if lookalikes:
        flag("high", "Name is one letter off the official package "
                     + ", ".join(lookalikes[:3]) + " — possible typosquat.")

# ------------------------------------------------------------------ PKGBUILD
PATTERNS = [
    (r"(curl|wget)[^|\n]*\|\s*(ba|z|da)?sh\b", "high", "downloads and pipes straight into a shell"),
    (r"base64\s+(-d|--decode)", "high", "decodes a hidden base64 blob"),
    (r"\beval\b", "warn", "uses eval"),
    (r"python[0-9.]*\s+-c\b", "warn", "runs inline Python"),
    (r"/dev/tcp/|\bnc\b.*\s-e\s|\bncat\b.*--exec", "high", "opens a raw network shell"),
    (r"https?://\d{1,3}(\.\d{1,3}){3}", "high", "fetches from a bare IP address"),
    (r"pastebin\.|transfer\.sh|0x0\.st|ngrok\.|discord(app)?\.com/api/webhooks|paste\.ee|hastebin",
     "high", "talks to a paste site, tunnel or webhook"),
    (r"chmod\s+([ugoa]*\+s|[0-7]?[4-7][0-7]{3})\b", "high", "sets a setuid/setgid bit"),
    # A user's own startup files are never a packaging target; system-wide
    # profile.d, xdg autostart and cron.d are, but they also persist.
    (r"(\$HOME|~)/?\.(bashrc|zshrc|profile|bash_profile)|\bcrontab\b", "high",
     "writes into your shell startup or crontab"),
    (r"/etc/profile\.d|xdg/autostart|/etc/cron", "info",
     "installs a login, autostart or cron hook"),
    (r"systemctl\s+(enable|start)", "warn", "enables or starts a service during install"),
    # sudo as a command — not the word inside an optdepends description
    # like 'sudo: privilege elevation', which every AUR helper PKGBUILD has.
    (r"(^|[;&|(`]\s*|\$\(\s*)sudo\s+[-\w/$]", "warn", "calls sudo from the build"),
    (r"source(_\w+)?=\([^)]*http://", "warn", "downloads over plain http"),
]


def scan(name, text):
    hits = []
    for n, line in enumerate(text.splitlines(), 1):
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        for rx, sev, why in PATTERNS:
            if re.search(rx, s):
                hits.append((sev, why, name, n, s))
    return hits


hits = []
sources = set()
try:
    pb = fetch(f"{AUR}/cgit/aur.git/plain/PKGBUILD?h={urllib.parse.quote(base)}")
    hits += scan("PKGBUILD", pb)

    for m in re.finditer(r"(?:https?|git\+https?|ftp)://([^/\"'\s)]+)", pb):
        sources.add(m.group(1).split("@")[-1])

    # Checksums skipped for something that is not a VCS checkout means the
    # download could change under you without makepkg noticing.
    vcs = re.search(r"(git|hg|svn|bzr)\+", pb)
    if re.search(r"sums(_\w+)?=\([^)]*'SKIP'", pb) and not vcs:
        flag("warn", "Skips checksum verification for a non-VCS download.")

    inst = re.search(r"^\s*install=['\"]?([^'\"\s]+)", pb, re.M)
    if inst:
        name = inst.group(1).replace("$pkgname", pkg).replace("${pkgname}", pkg)
        try:
            hits += scan(name, fetch(f"{AUR}/cgit/aur.git/plain/{urllib.parse.quote(name)}"
                                     f"?h={urllib.parse.quote(base)}"))
            out.append(("fact", "Install script", name))
        except Exception:
            pass
except Exception as e:
    flag("warn", f"Could not fetch the PKGBUILD to scan it: {e}")

seen = set()
for sev, why, where, n, line in hits:
    if (why, where) not in seen:
        seen.add((why, where))
        flag(sev, f"{where} {why}.")
for sev, why, where, n, line in hits[:6]:
    out.append(("line", f"{where}:{n}", line[:140]))

for d in sorted(sources):
    out.append(("source", d))

# ------------------------------------------------------------------ verdict
sev = [s for s, _ in flags]
risk = "high" if "high" in sev else "medium" if "warn" in sev else "low"

if TEXT:
    colours = {"low": "\033[1;32m", "medium": "\033[1;33m", "high": "\033[1;31m"}
    marks = {"high": "\033[1;31m✗\033[0m", "warn": "\033[1;33m!\033[0m", "info": "\033[2m·\033[0m"}
    print(f"\033[1mAUR trust check for {pkg}:\033[0m {colours[risk]}{risk.upper()} RISK\033[0m\n")
    for kind, *f in out:
        if kind == "fact":
            print(f"  {f[0]:<17} {f[1]}")
    if sources:
        print(f"  {'Downloads from':<17} {', '.join(sorted(sources))}")
    if flags:
        print()
        for s, m in flags:
            print(f"  {marks[s]} {m}")
    lines = [f for k, *f in out if k == "line"]
    if lines:
        print("\n  Suspicious lines:")
        for where, line in lines:
            print(f"    \033[2m{where}\033[0m  {line}")
    print()
else:
    print(f"risk\t{risk}")
    for s, m in flags:
        print(f"flag\t{s}\t{m}")
    for kind, *f in out:
        print("\t".join([kind, *f]))
