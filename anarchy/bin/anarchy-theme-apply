#!/usr/bin/env bash
# anarchy-theme-apply — push the current DankMaterialShell palette into the
# apps DMS does not reach, and reload everything that needs telling.
#
# DMS regenerates ~/.cache/DankMaterialShell/dms-colors.json on every theme,
# wallpaper or light/dark change, and templates a handful of apps itself. It
# stops short of two things Omarchy did do: writing the KDE colour scheme that
# KDE apps actually read, and reloading running programs so the change is
# visible without restarting them.
#
# Run it by hand, or let the anarchy-theme.path unit run it on every change.

set -uo pipefail

COLORS=${DMS_COLORS:-$HOME/.cache/DankMaterialShell/dms-colors.json}
quiet=0
[[ ${1:-} == -q || ${1:-} == --quiet ]] && quiet=1
say() { (( quiet )) || printf '%s\n' "$*"; }

[[ -f $COLORS ]] || { echo "no palette at $COLORS — run DMS once" >&2; exit 1; }

mode=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('mode','dark'))" "$COLORS" 2>/dev/null)
mode=${mode:-dark}

# ------------------------------------------------------------------- foot
#
# Generated here rather than included from DMS: foot rejects an unknown section
# in an included file and then refuses to start at all, so the format is worth
# owning. foot wants bare rrggbb, no leading '#'.
foot_ini=$HOME/.config/foot/dank-colors.ini
if [[ -d $HOME/.config/foot ]]; then
  python3 - "$COLORS" "$foot_ini" <<'PY'
import json, sys
colors, out = sys.argv[1], sys.argv[2]
d = json.load(open(colors))
d16 = d.get("dank16", {})

def bare(h):
    return (h or "#000000").lstrip("#").lower()

def ansi(variant):
    return [bare(d16.get(f"color{i}", {}).get(variant) or
                 d16.get(f"color{i}", {}).get("default")) for i in range(16)]

lines = ["# Generated by anarchy-theme-apply. Edits here are overwritten."]
for variant, section in (("dark", "colors-dark"), ("light", "colors-light")):
    c = d.get("colors", {}).get(variant)
    if not c:
        continue
    a = ansi(variant)
    lines += [
        "", f"[{section}]",
        f"background={bare(c.get('surface') or c.get('background'))}",
        f"foreground={bare(c.get('on_surface') or c.get('on_background'))}",
        f"selection-background={bare(c.get('primary_container'))}",
        f"selection-foreground={bare(c.get('on_primary_container'))}",
        f"cursor={bare(c.get('surface'))} {bare(c.get('primary'))}",
        f"urls={bare(c.get('primary'))}",
    ]
    for i in range(8):
        lines.append(f"regular{i}={a[i]}")
    for i in range(8):
        lines.append(f"bright{i}={a[i+8]}")

open(out, "w").write("\n".join(lines) + "\n")
PY
  # A malformed colour file would stop foot starting, so prove it parses and
  # roll back to the previous one if it does not.
  if foot --check-config >/dev/null 2>&1; then
    say "foot:   colours written"
  else
    printf '# anarchy-theme-apply produced an invalid file; neutralised.\n' > "$foot_ini"
    echo "foot: generated colours were rejected, left the theme unset" >&2
  fi
fi

# --------------------------------------------------------------------- KDE
#
# DMS writes ~/.local/share/color-schemes/DankMatugen{Dark,Light}.colors but
# never applies one, so Dolphin and friends keep whatever kdeglobals says —
# which on a fresh install is light Breeze.
scheme="DankMatugen$( [[ $mode == light ]] && echo Light || echo Dark )"
if command -v plasma-apply-colorscheme >/dev/null 2>&1 \
   && [[ -f $HOME/.local/share/color-schemes/$scheme.colors ]]; then
  if grep -q "^ColorScheme=$scheme$" "$HOME/.config/kdeglobals" 2>/dev/null; then
    say "kde:    already on $scheme"
  elif plasma-apply-colorscheme "$scheme" >/dev/null 2>&1; then
    say "kde:    $scheme applied"
  else
    echo "kde: plasma-apply-colorscheme failed" >&2
  fi
fi

# --------------------------------------------------------------------- GTK
#
# DMS writes the GTK css, but libadwaita apps only re-read on a settings
# change. Toggling the portal preference is what makes them repaint.
if command -v gsettings >/dev/null 2>&1; then
  want=$( [[ $mode == light ]] && echo "prefer-light" || echo "prefer-dark" )
  gsettings set org.gnome.desktop.interface color-scheme "$want" >/dev/null 2>&1 \
    && say "gtk:    color-scheme -> $want"
fi

# ---------------------------------------------------------------- reloads
#
# Tell running programs; each keeps running.
reload() {
  local name=$1 sig=$2
  pgrep -x "$name" >/dev/null 2>&1 || return 0
  pkill "-$sig" -x "$name" >/dev/null 2>&1 && say "reload: $name"
}
# foot keeps both palettes loaded and flips between them on a signal:
# USR1 selects [colors-dark], USR2 selects [colors-light].
reload foot "$( [[ $mode == light ]] && echo USR2 || echo USR1 )"
reload kitty  USR1
reload mako   USR2
reload btop   USR2
reload swayosd-server USR1

say "theme:  $mode"
