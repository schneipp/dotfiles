#!/usr/bin/env python3
"""anarchy-logo-braille — the anarchy artwork as coloured braille text art.

One braille character carries a 2x4 grid of dots, and a dot is almost exactly
square in a terminal cell, so a 48-column logo has 96 dots across. That is
enough resolution for the ring, the A and the wordmark to come out as smooth
lines rather than blocks, which half-block and ASCII-shape renderings could
not manage at this size. Each character takes the colour of the artwork under
its lit dots, so the cyan-to-magenta of the original survives.

    anarchy-logo-braille <image> [cols] [--crop w:h:x:y] [--threshold 0.3]
                         [--preview out.ppm] > logo.txt
"""
import argparse
import subprocess
import tempfile

ap = argparse.ArgumentParser()
ap.add_argument("image")
ap.add_argument("cols", nargs="?", type=int, default=48)
ap.add_argument("--crop")
ap.add_argument("--threshold", type=float, default=0.30)
ap.add_argument("--pre", default="")
ap.add_argument("--preview")
a = ap.parse_args()

probe = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0",
                        "-show_entries", "stream=width,height", "-of", "csv=p=0", a.image],
                       capture_output=True, text=True).stdout.strip().split(",")
iw, ih = (int(v) for v in probe)
if a.crop:
    iw, ih = (int(v) for v in a.crop.split(":")[:2])

# Terminal cells are ~0.6 x 1.36 em, so a braille dot is 0.30 x 0.34 em —
# slightly tall. Squash the sample grid to match, or circles come out as eggs.
DX = a.cols * 2
DY = round(DX * ih / iw * 0.30 / 0.34 / 4) * 4

tmp = tempfile.mkdtemp()
vf = (f"crop={a.crop}," if a.crop else "") + (a.pre + "," if a.pre else "") \
    + f"scale={DX}:{DY}:flags=area,format=rgb24"
subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", a.image, "-vf", vf,
                "-f", "rawvideo", "-pix_fmt", "rgb24", f"{tmp}/img.raw"], check=True)
img = open(f"{tmp}/img.raw", "rb").read()


def px(x, y):
    i = (y * DX + x) * 3
    return img[i], img[i + 1], img[i + 2]


def lit(x, y):
    # Brightness as the strongest channel, not luminance: luminance weights blue
    # at 7%, so the logo's violet and magenta strokes would read as dark and
    # the right-hand side of the ring would fall apart.
    return max(px(x, y)) / 255 > a.threshold


# Braille bit for dot (dx, dy) within a cell.
BITS = {(0, 0): 0x01, (0, 1): 0x02, (0, 2): 0x04, (1, 0): 0x08,
        (1, 1): 0x10, (1, 2): 0x20, (0, 3): 0x40, (1, 3): 0x80}

rows = []
for cy in range(DY // 4):
    line = []
    for cx in range(a.cols):
        bits, sr, sg, sb, n = 0, 0, 0, 0, 0
        for (dx, dy), bit in BITS.items():
            x, y = cx * 2 + dx, cy * 4 + dy
            if lit(x, y):
                bits |= bit
                r, g, b = px(x, y)
                sr += r; sg += g; sb += b; n += 1
        if bits:
            rgb = [sr / n, sg / n, sb / n]
            k = 255 / max(max(rgb), 1)          # full brightness, keep the hue
            line.append((chr(0x2800 + bits), tuple(min(255, round(v * k)) for v in rgb)))
        else:
            line.append((" ", None))
    rows.append(line)

# Trim empty rows and a shared left margin.
rows = [l for l in rows if any(c != " " for c, _ in l)]
left = min(next(i for i, (c, _) in enumerate(l) if c != " ") for l in rows)
rows = [l[left:] for l in rows]

for l in rows:
    s, last = "", None
    for ch, rgb in l:
        if rgb is None:
            s += " "
            continue
        if rgb != last:
            s += "\x1b[38;2;%d;%d;%dm" % rgb
            last = rgb
        s += ch
    print(s.rstrip() + "\x1b[0m")

if a.preview:                       # dots drawn as small squares, for checking
    S = 6
    w = max(len(l) for l in rows) * 2 * S
    h = len(rows) * 4 * S
    buf = bytearray(w * h * 3)
    for r, l in enumerate(rows):
        for c, (ch, rgb) in enumerate(l):
            if rgb is None:
                continue
            bits = ord(ch) - 0x2800
            for (dx, dy), bit in BITS.items():
                if bits & bit:
                    for y in range(1, S - 1):
                        for x in range(1, S - 1):
                            o = (((r * 4 + dy) * S + y) * w + (c * 2 + dx) * S + x) * 3
                            buf[o:o + 3] = bytes(rgb)
    open(a.preview, "wb").write(b"P6 %d %d 255\n" % (w, h) + bytes(buf))
