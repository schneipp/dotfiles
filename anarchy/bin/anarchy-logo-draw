#!/usr/bin/env python3
"""anarchy-logo-draw — the circled-A, drawn for the terminal.

Scaling the painted logo down to ~40 cells blurs it into mush, because each
cell has to average a big patch of soft glow. So the symbol is drawn from
geometry instead: a ring, an A whose apex breaks out of the top and whose
legs run out of the bottom, and a crossbar cutting through both sides —
rasterised at the exact cell grid, so every edge lands on a cell boundary.

Two pixels per character cell via half blocks, coloured with the logo's
cyan-to-magenta gradient in 24-bit colour.

    anarchy-logo-draw [size] > ~/.config/fastfetch/anarchy.txt
"""
import math
import sys

N = int(sys.argv[1]) if len(sys.argv) > 1 else 44   # columns == pixel rows
W = H = N
cx, cy = (W - 1) / 2, (H - 1) / 2 + N * 0.03

ring_r = N * 0.355         # centre line of the ring
ring_w = N * 0.05          # ring stroke
stroke = N * 0.062         # A strokes

apex = (cx, N * 0.02)                        # breaks out above the ring
foot_l = (cx - N * 0.43, N * 0.99)           # legs break out below
foot_r = (cx + N * 0.43, N * 0.99)
bar_y = cy + N * 0.10
bar_l, bar_r = (N * 0.02, bar_y), (N * 0.98, bar_y)   # crossbar past both sides


def seg_dist(px, py, a, b):
    ax, ay = a
    bx, by = b
    dx, dy = bx - ax, by - ay
    t = max(0.0, min(1.0, ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)))
    return math.hypot(px - (ax + t * dx), py - (ay + t * dy))


def ink(x, y):
    # 3x3 supersample so diagonal edges don't staircase on the half-block grid
    hits = 0
    for sx in (-0.33, 0, 0.33):
        for sy in (-0.33, 0, 0.33):
            px, py = x + sx, y + sy
            r = math.hypot(px - cx, py - cy)
            if (abs(r - ring_r) <= ring_w / 2
                    or seg_dist(px, py, apex, foot_l) <= stroke / 2
                    or seg_dist(px, py, apex, foot_r) <= stroke / 2
                    or seg_dist(px, py, bar_l, bar_r) <= stroke / 2):
                hits += 1
    return hits >= 4


# The painted logo runs cyan at the top into violet and magenta at the base.
STOPS = [(0.0, (45, 226, 245)), (0.55, (80, 130, 245)), (1.0, (205, 70, 240))]


def colour(y):
    t = y / (H - 1)
    for (t0, c0), (t1, c1) in zip(STOPS, STOPS[1:]):
        if t <= t1:
            k = (t - t0) / (t1 - t0)
            return tuple(round(a + (b - a) * k) for a, b in zip(c0, c1))
    return STOPS[-1][1]


rows = []
for y in range(0, H, 2):
    line = []
    for x in range(W):
        top, bot = ink(x, y), ink(x, y + 1) if y + 1 < H else False
        if top and bot:
            (r1, g1, b1), (r2, g2, b2) = colour(y), colour(y + 1)
            line.append(f"\x1b[38;2;{r1};{g1};{b1}m\x1b[48;2;{r2};{g2};{b2}m▀\x1b[0m")
        elif top:
            r, g, b = colour(y)
            line.append(f"\x1b[38;2;{r};{g};{b}m▀\x1b[0m")
        elif bot:
            r, g, b = colour(y + 1)
            line.append(f"\x1b[38;2;{r};{g};{b}m▄\x1b[0m")
        else:
            line.append(" ")
    rows.append("".join(line).rstrip())

sys.stdout.write("\n".join(rows) + "\n")
