#!/usr/bin/env bash
# qsl-pkg — package backend for the Quickshell launcher (qsl).
#
# The launcher calls the query subcommands directly and hands the
# mutating ones (install/remove) to a floating terminal, because those
# need sudo and want to show pacman's progress output.

set -uo pipefail

# Arch (pacman, optionally paru/yay for the AUR) or Fedora (dnf, plus flatpak
# for Flathub). The launcher only ever sees the output formats below, which
# are the same on both.
if command -v pacman >/dev/null 2>&1; then
  DISTRO=arch
elif command -v dnf >/dev/null 2>&1; then
  DISTRO=fedora
else
  printf 'qsl-pkg: neither pacman nor dnf found\n' >&2; exit 1
fi

AUR=""
if [[ $DISTRO == arch ]]; then
  for h in paru yay; do
    if command -v "$h" >/dev/null 2>&1; then AUR="$h"; break; fi
  done
fi

# Flathub, when flatpak is installed and the remote is configured.
FLATHUB=0
if command -v flatpak >/dev/null 2>&1 &&
   flatpak remotes --columns=name 2>/dev/null | grep -qx flathub; then
  FLATHUB=1
fi

APP_DIRS=(
  "$HOME/.local/share/applications"
  /usr/local/share/applications
  /usr/share/applications
  "$HOME/.local/share/flatpak/exports/share/applications"
  /var/lib/flatpak/exports/share/applications
)

die() { printf '%s\n' "$*" >&2; exit 1; }

# Wait for a keypress so the floating terminal doesn't vanish before it's read.
# Braces around the redirect so a missing controlling terminal is silent too —
# bash reports redirection failures itself, before the command runs.
pause() {
  printf '\n\033[2mPress any key to close…\033[0m'
  { read -rsn1 </dev/tty; } 2>/dev/null || true
  echo
}

# Read a y/N answer. Defaults to "no" if there's no terminal to ask on.
ask() {
  local reply=""
  printf '\n\033[1m%s [y/N]\033[0m ' "$1"
  { read -r reply </dev/tty; } 2>/dev/null || return 1
  [[ $reply =~ ^[Yy]$ ]]
}

# ---------------------------------------------------------------- queries

# managers -> one "id<TAB>label<TAB>description" per line, best default first.
#
# An AUR helper searches the official repos as well, so when one is present it
# is listed first and covers both. The narrower sources stay available for when
# you want to be sure where something is coming from.
cmd_managers() {
  if [[ $DISTRO == fedora ]]; then
    if (( FLATHUB )); then
      printf 'all\tEverything\tFedora repos, enabled COPRs and Flathub\n'
    fi
    printf 'dnf\tFedora repos\tFedora + enabled COPRs via dnf\n'
    if (( FLATHUB )); then
      printf 'flatpak\tFlathub only\tSandboxed apps via flatpak\n'
    fi
    return 0
  fi
  if [[ -n $AUR ]]; then
    printf 'all\tEverything\tOfficial repos and the AUR, via %s\n' "$AUR"
  fi
  printf 'pacman\tOfficial repos only\tArch + CachyOS packages via pacman\n'
  if [[ -n $AUR ]]; then
    printf 'aur\tAUR only\tArch User Repository via %s\n' "$AUR"
  fi
}

owner_of() {
  case $DISTRO in
    arch)   pacman -Qoq "$1" 2>/dev/null ;;
    fedora) rpm -qf --qf '%{NAME}\n' "$1" 2>/dev/null | head -1 ;;
  esac
}

# owner <desktop-id> -> "pkg<TAB>name" | "file<TAB>path" | "none"
cmd_owner() {
  local id="${1:-}" f pkg
  [[ -n $id ]] || die "usage: qsl-pkg owner <desktop-id>"
  for d in "${APP_DIRS[@]}"; do
    f="$d/$id.desktop"
    [[ -f $f ]] || continue
    if [[ $f == */flatpak/exports/* ]]; then
      printf 'pkg\tflatpak:%s\n' "$id"
    elif pkg=$(owner_of "$f") && [[ -n $pkg ]]; then
      printf 'pkg\t%s\n' "$pkg"
    else
      printf 'file\t%s\n' "$f"
    fi
    return 0
  done
  printf 'none\n'
}

# list pacman -> every package name in the configured repos
cmd_list() {
  if [[ $DISTRO == fedora ]]; then
    case "${1:-dnf}" in
      all|dnf) dnf repoquery --quiet --available --qf '%{name}\n' 2>/dev/null ;;&
      all|flatpak) (( FLATHUB )) && flatpak remote-ls flathub --app --columns=application 2>/dev/null ;;
    esac | awk 'NF && !seen[$0]++'
    return 0
  fi
  case "${1:-pacman}" in
    all)    [[ -n $AUR ]] || die "no AUR helper installed"; "$AUR" -Slq 2>/dev/null ;;
    pacman) pacman -Slq ;;
    aur)    [[ -n $AUR ]] || die "no AUR helper installed"; "$AUR" -Slq aur 2>/dev/null ;;
    *)      die "unknown manager: $1" ;;
  esac | awk 'NF && !seen[$0]++'
}

# installed -> explicitly-installed package names (removal candidates)
cmd_installed() {
  case $DISTRO in
    arch)   pacman -Qqe ;;
    fedora) dnf repoquery --quiet --userinstalled --qf '%{name}\n' 2>/dev/null | sort -u ;;
  esac
  # Flatpak apps are removable too; the prefix tells remove which tool to use.
  command -v flatpak >/dev/null 2>&1 &&
    flatpak list --app --columns=application 2>/dev/null | sed 's/^/flatpak:/'
}

# search <manager> <query> -> "name<TAB>repo<TAB>installed<TAB>votes" per line,
# best match first. repo is where it comes from (extra, cachyos, aur, …),
# installed is 1 when the package is already on the system, and votes is the
# AUR vote count (empty for repo packages).
#
# The words go to pacman/paru as separate terms, which they AND together — as a
# single argument "signal desktop" is one regex that no package name contains.
# The raw order is repo order and buries the obvious hit under packages that
# merely mention the word in their description ("signal" put signal-desktop at
# 43rd), so results are re-ranked by how well the *name* matches.
cmd_search() {
  local mgr="${1:-pacman}"; shift
  local q="$*"
  read -ra words <<<"$q"
  (( ${#words[@]} )) || return 0

  if [[ $DISTRO == fedora ]]; then
    fedora_search "$mgr" "${words[@]}" | rank_results "${words[*]}" | head -300
    return 0
  fi

  # Full -Ss output rather than -Ssq: the header lines read
  # "repo/name version [...] [installed]", which is where the source label and
  # the installed marker come from. Description lines are indented; skip them.
  case "$mgr" in
    all)    [[ -n $AUR ]] || die "no AUR helper installed"
            "$AUR" -Ss -- "${words[@]}" 2>/dev/null ;;
    pacman) pacman -Ss -- "${words[@]}" 2>/dev/null ;;
    aur)    [[ -n $AUR ]] || die "no AUR helper installed"
            "$AUR" -Ssa -- "${words[@]}" 2>/dev/null ;;
    *)      die "unknown manager: $mgr" ;;
  esac | awk '/^[^[:space:]]+\/[^[:space:]]+ / {
      split($1, rn, "/")
      # AUR results carry "[+votes ~popularity]"; repo results have no votes.
      votes = ""
      if (match($0, /\[\+[0-9]+ /)) votes = substr($0, RSTART + 2, RLENGTH - 3)
      printf "%s\t%s\t%d\t%s\n", rn[2], rn[1], (tolower($0) ~ /\[installed/), votes
    }' | awk -F'\t' '{ print $1 "\t" $0 }' | rank_results "${words[*]}"
}

# rank_results <query> — input "key<TAB>name<TAB>repo<TAB>installed<TAB>votes",
# output the last four fields, best match first. key is what the query is
# matched against: the package name, or a Flatpak's display name.
rank_results() {
  awk -F'\t' -v q="$1" '
    BEGIN {
      q = tolower(q); n = split(q, w, " ")
      joined = w[1]; for (i = 2; i <= n; i++) joined = joined "-" w[i]
      glued = joined; gsub(/-/, "", glued)
    }
    # CachyOS mirrors several Arch repos, so the same name comes back twice.
    NF && !seen[$2]++ {
      name = tolower($1)
      if (name == joined || name == glued || name == w[1]) tier = 0
      else if (index(name, joined) == 1)              tier = 1
      else if (index(name, w[1]) == 1)                tier = 2
      else {
        all = 1
        for (i = 1; i <= n; i++) if (!index(name, w[i])) all = 0
        tier = all ? 3 : 4
      }
      # stable within a tier: keep the package manager own order
      sub(/^[^\t]*\t/, "")
      printf "%d\t%06d\t%s\n", tier, NR, $0
    }' | sort -t$'\t' -k1,1n -k2,2n | cut -f3-
}

# fedora_search <manager> <word...> -> key/name/repo/installed/votes lines.
# dnf matches on names (a glob per first word, the rest filtered by ranking);
# Flathub matches on display names and descriptions.
fedora_search() {
  local mgr=$1; shift
  local words=("$@")
  if [[ $mgr == all || $mgr == dnf ]]; then
    local installed
    installed=$(rpm -qa --qf '%{NAME}\n' 2>/dev/null)
    dnf repoquery --quiet --available --latest-limit 1 \
        --qf $'%{name}\t%{repoid}\n' "*${words[0]}*" 2>/dev/null |
      awk -F'\t' -v inst="$installed" '
        BEGIN { n = split(inst, a, "\n"); for (i = 1; i <= n; i++) have[a[i]] = 1 }
        # Debug symbols are packages of their own on Fedora; never what you want.
        NF >= 2 && $1 !~ /-debug(info|source)$/ && !seen[$1]++ {
          repo = $2
          # copr:copr.fedorainfracloud.org:owner:project -> copr (and coprdep:)
          if (repo ~ /^copr(dep)?:/) repo = "copr"
          else if (repo ~ /^updates/) repo = "fedora"
          printf "%s\t%s\t%s\t%d\t\n", $1, $1, repo, ($1 in have)
        }'
  fi
  if [[ $mgr == all || $mgr == flatpak ]] && (( FLATHUB )); then
    local apps
    apps=$(flatpak list --app --columns=application 2>/dev/null)
    flatpak search --columns=application,name,remotes -- "${words[@]}" 2>/dev/null |
      awk -F'\t' -v inst="$apps" '
        BEGIN { n = split(inst, a, "\n"); for (i = 1; i <= n; i++) have[a[i]] = 1 }
        NF >= 3 && $3 ~ /flathub/ && !seen[$1]++ {
          key = tolower($2); gsub(/ +/, "-", key)
          printf "%s\t%s\tflathub\t%d\t\n", key, $1, ($1 in have)
        }'
  fi
}

# is_flatpak_id <name> — reverse-DNS app id (org.signal.Signal), not an rpm.
is_flatpak_id() {
  [[ $1 == flatpak:* ]] && return 0
  [[ $1 =~ ^[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+){2,}$ ]] &&
    ! dnf repoquery --quiet --qf '%{name}\n' "$1" 2>/dev/null | grep -q .
}

# Flatpak commands go to whichever installation holds the Flathub remote.
flatpak_scope() {
  flatpak remotes --user --columns=name 2>/dev/null | grep -qx flathub && echo --user || echo --system
}

# info <manager> <pkg> -> human-readable details for the preview pane
cmd_info() {
  local mgr="${1:-pacman}" pkg="${2:-}"
  [[ -n $pkg ]] || return 0
  if [[ $DISTRO == fedora ]]; then
    fedora_info "$mgr" "$pkg"
    return 0
  fi
  case "$mgr" in
    all)    [[ -n $AUR ]] && "$AUR" -Si -- "$pkg" 2>/dev/null ;;
    pacman) pacman -Si -- "$pkg" 2>/dev/null || pacman -Qi -- "$pkg" 2>/dev/null ;;
    aur)    [[ -n $AUR ]] && "$AUR" -Si -- "$pkg" 2>/dev/null ;;
  esac
}

# fedora_info — dnf/flatpak details, renamed to the pacman keys the launcher's
# preview pane shows (Version, Description, Repository, Depends On, …).
fedora_info() {
  local mgr=$1 pkg=$2
  if [[ $mgr == flatpak ]] || { [[ $mgr == all ]] && is_flatpak_id "$pkg"; }; then
    flatpak remote-info flathub "${pkg#flatpak:}" 2>/dev/null | awk '
      NR == 1 && / - / { sub(/^[^-]* - /, ""); print "Description : " $0; next }
      /^ *(Version|License|Download|Installed|Runtime):/ {
        k = $1; sub(/:$/, "", k); v = $0; sub(/^[^:]*: */, "", v)
        if (k == "License")   k = "Licenses"
        if (k == "Download")  k = "Download Size"
        if (k == "Installed") k = "Installed Size"
        if (k == "Runtime")   k = "Depends On"
        print k " : " v
      }
      END { print "Repository : flathub" }'
    return 0
  fi
  dnf info --quiet "$pkg" 2>/dev/null | awk '
    /^[A-Za-z]/ && /:/ {
      k = $0; sub(/ *:.*/, "", k); v = $0; sub(/^[^:]*: ?/, "", v); key = ""
      if (k == "Version")                          key = "Version"
      else if (k == "Summary")                     key = "Description"
      else if (k == "Repository" || k == "From repository") {
        key = "Repository"
        # copr:copr.fedorainfracloud.org:owner:project -> copr owner/project
        if (split(v, c, ":") == 4 && c[1] ~ /^copr/) v = "copr " c[3] "/" c[4]
      }
      else if (k == "Installed size")              key = "Installed Size"
      else if (k == "Download size")               key = "Download Size"
      else if (k == "License")                     key = "Licenses"
      else if (k == "URL")                         key = "URL"
      if (key != "" && !(key in done)) { done[key] = 1; print key " : " v }
    }'
  local deps
  deps=$(dnf repoquery --quiet --latest-limit 1 --providers-of=requires \
           --qf '%{name}\n' "$pkg" 2>/dev/null | sort -u | paste -sd' ' | sed 's/ /  /g')
  [[ -n $deps ]] && printf 'Depends On : %s\n' "$deps"
}

# ---------------------------------------------------------------- mutations

cmd_install() {
  local mgr="${1:-}" pkg="${2:-}"
  [[ -n $mgr && -n $pkg ]] || die "usage: qsl-pkg install <pacman|aur> <pkg>"

  printf '\033[1;35m::\033[0m Installing \033[1m%s\033[0m from %s\n\n' "$pkg" "$mgr"

  if [[ $DISTRO == fedora ]]; then
    if [[ $mgr == flatpak ]] || { [[ $mgr == all ]] && is_flatpak_id "$pkg"; }; then
      flatpak install "$(flatpak_scope)" flathub "${pkg#flatpak:}"
    else
      sudo dnf install "$pkg"
    fi
    report_install $? "$pkg"
    return
  fi

  # An AUR package is whatever its submitter uploaded; nobody reviews it. Show
  # the trust report first, and make a high-risk one an explicit decision.
  if [[ $mgr != pacman ]] && ! pacman -Si -- "$pkg" >/dev/null 2>&1 \
     && command -v qsl-aur-audit >/dev/null 2>&1; then
    qsl-aur-audit --text "$pkg"
    if [[ $(qsl-aur-audit "$pkg" 2>/dev/null | awk -F'\t' '$1=="risk"{print $2}') == high ]]; then
      if ! ask "This package looks risky. Install it anyway?"; then
        printf '\nCancelled. Nothing was installed.\n'
        pause
        return 0
      fi
      echo
    fi
  fi

  case "$mgr" in
    all)    [[ -n $AUR ]] || die "no AUR helper installed"
            "$AUR" -S --needed -- "$pkg" ;;
    pacman) sudo pacman -S --needed -- "$pkg" ;;
    aur)    [[ -n $AUR ]] || die "no AUR helper installed"
            "$AUR" -S --needed -- "$pkg" ;;
    *)      die "unknown manager: $mgr" ;;
  esac
  report_install $? "$pkg"
}

report_install() {
  local rc=$1 pkg=$2
  if (( rc == 0 )); then
    printf '\n\033[1;32m✓\033[0m %s installed.\n' "$pkg"
  else
    printf '\n\033[1;31m✗\033[0m Install of %s failed (exit %d).\n' "$pkg" "$rc"
  fi
  pause
}

cmd_remove() {
  local pkg="${1:-}"
  [[ -n $pkg ]] || die "usage: qsl-pkg remove <pkg>"

  printf '\033[1;31m::\033[0m Uninstalling \033[1m%s\033[0m\n\n' "$pkg"

  # Flatpak and dnf both list what goes and ask before doing it themselves.
  if [[ $pkg == flatpak:* ]]; then
    local id=${pkg#flatpak:} scope=--system
    flatpak list --user --app --columns=application 2>/dev/null | grep -qx "$id" && scope=--user
    flatpak uninstall "$scope" "$id"
    report_remove $?
    return
  fi
  if [[ $DISTRO == fedora ]]; then
    sudo dnf remove "$pkg"
    report_remove $?
    return
  fi

  # Show the full blast radius before touching anything.
  # NOTE: -Rns implies --nosave, which pacman refuses to combine with --print,
  # so the dry run uses -Rs and only the real removal uses -Rns.
  local deps err
  err=$(pacman -Rs --print --print-format '%n' -- "$pkg" 2>&1 >/dev/null)
  deps=$(pacman -Rs --print --print-format '%n' -- "$pkg" 2>/dev/null)
  if [[ -z $deps ]]; then
    printf '\033[1;31m✗\033[0m Cannot remove %s:\n\n%s\n' "$pkg" "${err:-not installed}"
    pause
    return 1
  fi

  local count
  count=$(printf '%s\n' "$deps" | wc -l)
  printf 'The following %s package(s) will be removed:\n\n' "$count"
  printf '%s\n' "$deps" | column -c "${COLUMNS:-80}" 2>/dev/null || printf '%s\n' "$deps"

  if ! ask "Proceed?"; then
    printf '\nCancelled. Nothing was removed.\n'
    pause
    return 0
  fi

  echo
  sudo pacman -Rns -- "$pkg"
  report_remove $?
}

report_remove() {
  if (( $1 == 0 )); then
    printf '\n\033[1;32m✓\033[0m %s removed.\n' "$pkg"
  else
    printf '\n\033[1;31m✗\033[0m Removal failed (exit %d).\n' "$1"
  fi
  pause
}

# ---------------------------------------------------------------- upkeep
# The launcher's Update menu. One entry point per job, so the menu reads the
# same on every distro.

# upgrade — the whole system from the native package manager.
cmd_upgrade() {
  case $DISTRO in
    arch)   sudo pacman -Syu ;;
    fedora) sudo dnf upgrade --refresh ;;
  esac
  pause
}

# upgrade-extra — what the native manager doesn't cover: AUR or Flatpak.
cmd_upgrade_extra() {
  if [[ -n $AUR ]]; then "$AUR" -Sua; fi
  if command -v flatpak >/dev/null 2>&1; then flatpak update; fi
  [[ -z $AUR ]] && ! command -v flatpak >/dev/null 2>&1 && echo "No AUR helper or Flatpak installed."
  pause
}

# orphans — dependencies nothing needs any more.
cmd_orphans() {
  case $DISTRO in
    arch)
      local o
      o=$(pacman -Qtdq)
      if [[ -n $o ]]; then printf '%s\n' "$o" | sudo pacman -Rns -; else echo "No orphans."; fi ;;
    fedora)
      sudo dnf autoremove ;;
  esac
  command -v flatpak >/dev/null 2>&1 && flatpak uninstall --unused
  pause
}

# Delete a .desktop file that no package owns (hand-made or webapp shortcuts).
cmd_forget() {
  local f="${1:-}"
  [[ -n $f && -f $f ]] || die "usage: qsl-pkg forget <desktop-file>"
  printf 'This entry belongs to no package. Delete the launcher file?\n\n  %s\n' "$f"
  if ask "Delete?"; then
    rm -f -- "$f" && printf '\n\033[1;32m✓\033[0m Removed %s\n' "$f"
  else
    printf '\nCancelled.\n'
  fi
  pause
}

# ---------------------------------------------------------------- dispatch

case "${1:-}" in
  managers) shift; cmd_managers "$@" ;;
  owner)    shift; cmd_owner    "$@" ;;
  list)     shift; cmd_list     "$@" ;;
  installed) shift; cmd_installed "$@" ;;
  audit)    shift; exec qsl-aur-audit "$@" ;;
  search)   shift; cmd_search   "$@" ;;
  info)     shift; cmd_info     "$@" ;;
  install)  shift; cmd_install  "$@" ;;
  remove)   shift; cmd_remove   "$@" ;;
  forget)   shift; cmd_forget   "$@" ;;
  upgrade)  shift; cmd_upgrade  "$@" ;;
  upgrade-extra) shift; cmd_upgrade_extra "$@" ;;
  orphans)  shift; cmd_orphans  "$@" ;;
  distro)   echo "$DISTRO" ;;
  *) die "usage: qsl-pkg {managers|owner|list|installed|search|info|audit|install|remove|forget|upgrade|upgrade-extra|orphans|distro} [args]" ;;
esac
