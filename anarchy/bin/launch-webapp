#!/bin/bash
# Launch a URL as a standalone web app window.
#
# Replaces omarchy-launch-webapp. Needs a Chromium-family browser, because
# --app= is the flag that produces a chrome-less window; Firefox has no
# equivalent (it dropped --ssb years ago).

set -euo pipefail

url=${1:-}
if [[ -z $url ]]; then
  echo "Usage: launch-webapp <url> [browser args...]" >&2
  exit 1
fi
shift

# Prefer whatever the desktop default is, but only if it's Chromium-family.
browser=""
default=$(xdg-settings get default-web-browser 2>/dev/null || true)
case $default in
google-chrome* | brave* | chromium* | microsoft-edge* | opera* | vivaldi* | helium*)
  browser=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' \
    {"$HOME/.local","$HOME/.nix-profile",/usr}/share/applications/"$default" 2>/dev/null | head -1)
  ;;
esac

# Otherwise take the first Chromium-family browser on PATH.
if [[ -z $browser ]]; then
  for candidate in brave brave-browser chromium google-chrome-stable google-chrome \
                   microsoft-edge-stable vivaldi-stable opera helium; do
    if command -v "$candidate" >/dev/null 2>&1; then
      browser=$(command -v "$candidate")
      break
    fi
  done
fi

if [[ -z $browser ]]; then
  msg="No Chromium-based browser found. Web apps need one of: brave, chromium, google-chrome, microsoft-edge, vivaldi, opera."
  echo "$msg" >&2
  command -v notify-send >/dev/null 2>&1 && notify-send "Can't open web app" "$msg"
  exit 1
fi

exec setsid "$browser" --app="$url" "$@"
